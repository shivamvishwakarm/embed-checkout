# apps/merchant — copy to apps/merchant/.env.local
NEXT_PUBLIC_CHECKOUT_URL=http://localhost:3001
NEXT_PUBLIC_CHECKOUT_ORIGIN=http://localhost:3001

# apps/checkout — copy to apps/checkout/.env.local
NEXT_PUBLIC_MERCHANT_ORIGIN=http://localhost:3000

# Production values (example)
# NEXT_PUBLIC_CHECKOUT_URL=https://checkout.dodo.example.com
# NEXT_PUBLIC_CHECKOUT_ORIGIN=https://checkout.dodo.example.com
# NEXT_PUBLIC_MERCHANT_ORIGIN=https://demo.dodo.example.com
